<form>
    <field>
        <id>modem.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>modem.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Friendly name (letters, numbers, underscore and hyphen).</help>
    </field>
    <field>
        <id>modem.ip_address</id>
        <label>IP address</label>
        <type>text</type>
        <help>Modem management address, usually 192.168.8.1.</help>
    </field>
    <field>
        <id>modem.username</id>
        <label>Username</label>
        <type>text</type>
        <help>Web interface username, usually admin.</help>
    </field>
    <field>
        <id>modem.password</id>
        <label>Password</label>
        <type>password</type>
        <help>Web interface password. Leave empty if the modem does not require a login.</help>
    </field>
    <field>
        <id>modem.auto_connect</id>
        <label>Auto connect</label>
        <type>checkbox</type>
        <help>Automatically reconnect the mobile data session when it drops.</help>
    </field>
    <field>
        <id>modem.roaming_enabled</id>
        <label>Allow roaming</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>modem.network_mode</id>
        <label>Network mode</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>modem.reconnect_interval</id>
        <label>Reconnect interval</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Seconds between reconnect attempts (10-3600).</help>
    </field>
    <field>
        <id>modem.max_reconnect_attempts</id>
        <label>Max reconnect attempts</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Reconnect attempts before backing off (1-10).</help>
    </field>
    <field>
        <id>modem.auto_disconnect_min</id>
        <label>Auto disconnect (min)</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Disconnect the mobile data session after this many idle minutes (0 = disabled).</help>
    </field>
    <field>
        <id>modem.lte_band</id>
        <label>LTE band bitmask</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Hex bitmask of LTE bands to lock (e.g. 80005 = B1+B3+B20; band N = 2**(N-1)). ALL = 7FFFFFFFFFFFFFFF. Leave at ALL for automatic.</help>
    </field>
    <field>
        <id>modem.network_band</id>
        <label>3G/2G band bitmask</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Hex bitmask of UMTS/GSM bands (e.g. 400000 = UMTS B1/2100). ALL = 3FFFFFFF. Leave at ALL for automatic.</help>
    </field>
    <field>
        <id>modem.network_search</id>
        <label>Network search</label>
        <type>dropdown</type>
        <advanced>true</advanced>
    </field>
    <field>
        <id>modem.manual_plmn</id>
        <label>Manual PLMN code</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>PLMN code (Numeric) for manual network selection; ignored in automatic mode.</help>
    </field>
    <field>
        <id>modem.manual_rat</id>
        <label>Manual RAT</label>
        <type>dropdown</type>
        <advanced>true</advanced>
    </field>
    <field>
        <id>modem.active_profile</id>
        <label>Active APN profile</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>APN profile index to activate on the modem (from the modem's profile list). Leave empty to keep the current profile.</help>
    </field>
    <field>
        <id>modem.collect_interval</id>
        <label>Collect interval</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Seconds between metric collections (10-300).</help>
    </field>
    <field>
        <id>modem.signal_threshold</id>
        <label>Signal threshold</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Warn when signal drops below this dBm value (-120 to -50).</help>
    </field>
    <field>
        <id>modem.data_limit_enabled</id>
        <label>Enforce data limit</label>
        <type>checkbox</type>
        <help>Disconnect the modem when the monthly data limit is reached.</help>
    </field>
    <field>
        <id>modem.data_limit_mb</id>
        <label>Data limit (MB)</label>
        <type>text</type>
        <help>Monthly data limit in megabytes.</help>
    </field>
    <field>
        <id>modem.alert_email</id>
        <label>Alert email</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Optional per-modem alert email address.</help>
    </field>
</form>
